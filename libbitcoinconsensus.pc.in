prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: @PACKAGE_NAME@ consensus library
Description: Library for the Elements consensus protocol.
Version: @PACKAGE_VERSION@
Libs: -L${libdir} -lelementsconsensus
Libs.private: @ELEMENTS_CONSENSUS_PRIVATE_LIBS@
Cflags: -I${includedir}
