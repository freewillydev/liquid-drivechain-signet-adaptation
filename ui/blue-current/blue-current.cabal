cabal-version: 3.8
name: elements-blue-current
version: 0.1.0.0
synopsis: Readable Elements wallet in Haskell and Monomer
license: MIT
license-file: LICENSE
build-type: Simple
extra-source-files: README.md, scripts/*.py, scripts/*.ps1, ci/*.yml, cbits/*.hpp, release/*.json, CMakeLists.txt
data-files: assets/*.ttf, assets/*.png, assets/*.ico, assets/*.icns, assets/FONT-LICENSE.txt

common settings
  default-language: GHC2021
  default-extensions: OverloadedStrings
  ghc-options: -Wall

library
  import: settings
  hs-source-dirs: src
  exposed-modules: BlueCurrent.Model, BlueCurrent.Backend, BlueCurrent.QR,
    BlueCurrent.Types, BlueCurrent.Node, BlueCurrent.Runtime
  build-depends:
    base >=4.18 && <5, aeson >=2.2, bytestring, containers, directory,
    filepath, process, qrcode-core ==0.9.11, scientific, text, time, vector

executable elements-blue-current
  import: settings
  hs-source-dirs: app
  main-is: Main.hs
  other-modules: BlueCurrent.View, BlueCurrent.Accessibility, Paths_elements_blue_current
  autogen-modules: Paths_elements_blue_current
  if os(windows)
    ghc-options: -optl-mwindows
    cxx-sources: cbits/accessibility_windows.cpp
    cxx-options: -std=c++17
    extra-libraries: ole32, oleaut32, uuid
  if os(linux)
    cxx-sources: cbits/accessibility_linux.cpp
    cxx-options: -std=c++17
    pkgconfig-depends: sdl2, atk >=2.50, atk-bridge-2.0
    extra-libraries: stdc++
  if os(osx)
    c-sources: cbits/accessibility.m
    frameworks: Cocoa
  ghc-options: -threaded -rtsopts
  build-depends:
    base, elements-blue-current, bytestring, lens, monomer ==1.6.0.1,
    text, time, directory, filepath, aeson

test-suite wallet-behavior
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends: base, elements-blue-current, aeson, bytestring, text, directory, filepath, time

test-suite live-wallet
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: LiveMain.hs
  build-depends: base, elements-blue-current, aeson, text, directory, filepath, time
