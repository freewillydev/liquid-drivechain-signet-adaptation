# Bundle a native Windows release from actual PE imports. No toolchain PATH is
# used for resolution; callers provide the complete, reviewed search roots.
cmake_minimum_required(VERSION 3.25)
if(POLICY CMP0207)
  cmake_policy(SET CMP0207 NEW)
endif()
foreach(required ROOT_BINARIES SEARCH_DIRECTORIES OUTPUT_DIRECTORY OBJDUMP)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
if(NOT CMAKE_HOST_WIN32)
  message(FATAL_ERROR "Qualify and bundle the native Windows build on Windows")
endif()
if(NOT IS_ABSOLUTE "${OUTPUT_DIRECTORY}" OR EXISTS "${OUTPUT_DIRECTORY}")
  message(FATAL_ERROR "Output must be a new absolute directory, never an existing bundle")
endif()
if(NOT IS_ABSOLUTE "${OBJDUMP}" OR NOT EXISTS "${OBJDUMP}")
  message(FATAL_ERROR "Select the reviewed toolchain's absolute objdump executable")
endif()
set(allowed_directories ${SEARCH_DIRECTORIES})
foreach(binary IN LISTS ROOT_BINARIES)
  if(NOT IS_ABSOLUTE "${binary}" OR NOT EXISTS "${binary}" OR IS_DIRECTORY "${binary}")
    message(FATAL_ERROR "Invalid release input: ${binary}")
  endif()
  get_filename_component(directory "${binary}" DIRECTORY)
  list(APPEND allowed_directories "${directory}")
  execute_process(COMMAND "${OBJDUMP}" -f "${binary}" OUTPUT_VARIABLE format
    COMMAND_ERROR_IS_FATAL ANY)
  if(NOT format MATCHES "file format pei-x86-64")
    message(FATAL_ERROR "Not a native x86-64 PE release input: ${binary}")
  endif()
endforeach()
foreach(directory IN LISTS allowed_directories)
  if(NOT IS_ABSOLUTE "${directory}" OR NOT IS_DIRECTORY "${directory}")
    message(FATAL_ERROR "Invalid dependency search directory: ${directory}")
  endif()
endforeach()
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL objdump)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${OBJDUMP}")
file(GET_RUNTIME_DEPENDENCIES EXECUTABLES ${ROOT_BINARIES}
  DIRECTORIES ${SEARCH_DIRECTORIES}
  RESOLVED_DEPENDENCIES_VAR dependencies UNRESOLVED_DEPENDENCIES_VAR unresolved
  CONFLICTING_DEPENDENCIES_PREFIX conflicts
  PRE_EXCLUDE_REGEXES "^[Aa][Pp][Ii]-[Mm][Ss]-[Ww][Ii][Nn]-" "^[Ee][Xx][Tt]-[Mm][Ss]-[Ww][Ii][Nn]-"
  POST_EXCLUDE_REGEXES "[Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\\\][Ss][Yy][Ss][Tt][Ee][Mm]32[/\\\\]")
if(unresolved OR conflicts_FILENAMES)
  message(FATAL_ERROR "Unresolved/conflicting PE dependencies: ${unresolved};${conflicts_FILENAMES}")
endif()
set(files ${ROOT_BINARIES} ${dependencies})
list(REMOVE_DUPLICATES files)
list(SORT files)
set(names)
set(manifest "")
foreach(input IN LISTS files)
  file(REAL_PATH "${input}" real_input)
  string(TOLOWER "${real_input}" comparison_input)
  set(allowed FALSE)
  foreach(directory IN LISTS allowed_directories)
    file(REAL_PATH "${directory}" real_directory)
    string(TOLOWER "${real_directory}" comparison_directory)
    cmake_path(IS_PREFIX comparison_directory "${comparison_input}" NORMALIZE inside)
    if(inside)
      set(allowed TRUE)
    endif()
  endforeach()
  if(NOT allowed)
    message(FATAL_ERROR "Dependency resolved outside reviewed roots: ${input}")
  endif()
  get_filename_component(name "${input}" NAME)
  string(TOLOWER "${name}" key)
  if(NOT name MATCHES "^[A-Za-z0-9_.+-]+$" OR key IN_LIST names)
    message(FATAL_ERROR "Unsafe or colliding release basename: ${name}")
  endif()
  list(APPEND names "${key}")
  file(SHA256 "${input}" digest)
  set(expected_${key} "${digest}")
  string(APPEND manifest "${digest}  ${name}\n")
endforeach()
# Resolve and validate everything before publishing any bundle bytes.
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
foreach(input IN LISTS files)
  get_filename_component(name "${input}" NAME)
  string(TOLOWER "${name}" key)
  file(COPY_FILE "${input}" "${OUTPUT_DIRECTORY}/${name}" ONLY_IF_DIFFERENT)
  file(SHA256 "${OUTPUT_DIRECTORY}/${name}" digest)
  if(NOT digest STREQUAL expected_${key})
    message(FATAL_ERROR "Release input changed while copying: ${name}")
  endif()
endforeach()
file(WRITE "${OUTPUT_DIRECTORY}/SHA256SUMS" "${manifest}")
list(LENGTH files count)
message(STATUS "Bundled ${count} checksummed executable/runtime files")
