cabal-version: 2.4
name: elements-haskell-tests
version: 0.1.0.0
license: MIT
build-type: Simple

test-suite properties
  type: exitcode-stdio-1.0
  main-is: Properties.hs
  hs-source-dirs: test, .
  other-modules: Utreexo, Abi, DomainABI, AbiTests, Drivechain, Withdrawal, Deposit, NativeDeposit, Bmm, BmmConstants, ParentBlock, ParentHeader, ParentReplay, ParentCache, ReplayStore, NodeRules, ScriptPolicy, CapabilityContext, Workflow, OperationTests, ParentBlockTests, ParentHeaderTests, ParentRpcTests, ReplayStoreTests, DepositConstructionTests, DepositParsingTests, DepositClaimTests, NativeDepositTests, ConfirmationDepthTests, LocalBidTests, BmmContextTests, WalletWithdrawalTests, JournalWorkflowTests, BmmHeaderPolicyTests, BmmStateAccessTests, StateStorageTests, ProofSessionTests, BmmChainTests, CommitmentTests, SignetSessionTests
  cxx-sources: test/reference.cpp
  if os(osx)
    extra-libraries: c++
  else
    extra-libraries: stdc++
  build-depends: base >=4.18 && <5, bytestring, binary, containers, transformers >=0.6 && <0.7, QuickCheck ==2.15.0.1, operation-capabilities ==0.3.0.0
  default-language: Haskell2010
  ghc-options: -Wall -Werror -threaded
