cabal-version: 2.4
name: elements-haskell-tests
version: 0.1.0.0
license: MIT
build-type: Simple

test-suite properties
  type: exitcode-stdio-1.0
  main-is: Properties.hs
  hs-source-dirs: test, .
  other-modules: Abi, DomainABI, AbiTests, Drivechain, Withdrawal, Deposit, Bmm, BmmConstants, ParentReplay, Exchange, Usdd, ScriptPolicy, CapabilityContext, Workflow, ExchangeTests, OperationTests
  cxx-sources: test/reference.cpp
  -- The pinned native Windows GHC uses LLVM/libc++ for its C++ test oracle.
  if os(osx) || os(windows)
    extra-libraries: c++
  else
    extra-libraries: stdc++
  build-depends: base >=4.18 && <5, bytestring, transformers >=0.6 && <0.7, QuickCheck ==2.15.0.1, operation-capabilities ==0.3.0.0
  default-language: Haskell2010
  ghc-options: -Wall -Werror -threaded
